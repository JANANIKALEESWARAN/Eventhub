{
    "appId":  "com.eventhub.app",
    "appName":  "EventHub",
    "webDir":  "dist",
    "server": {
        "androidScheme": "http",
        "cleartext": true
    },
    "android":  {
                    "allowMixedContent":  true,
                    "captureInput":  true,
                    "webContentsDebuggingEnabled":  true
                },
    "plugins":  {
                    "SplashScreen":  {
                                         "launchShowDuration":  2000,
                                         "backgroundColor":  "#ffffff",
                                         "showSpinner":  false
                                     }
                }
}
